<?xml version="1.0" encoding="utf-8"?>
<!-- SignalLink Green API (.NET) - IIS 호스팅 설정.
     주의: aspNetCore / security 요소는 반드시 system.webServer 안에 있어야
     한다. configuration 바로 아래에 두면 IIS 가 500.19 구성 오류를 낸다. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- 첫 가동 진단용으로 stdout 로그를 켜 둔다(logs\stdout*.log).
           안정화되면 stdoutLogEnabled="false" 로 끌 것. -->
      <aspNetCore processPath="dotnet" arguments=".\SignalLink.Api.dll"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- [필수 교체] 운영 비밀키. 개발 .env 의 키와 달라야 한다. -->
          <environmentVariable name="SecretKey" value="CHANGE-ME-운영용-긴-비밀키-32자-이상" />
          <environmentVariable name="DeviceMasterKey" value="CHANGE-ME-운영용-장치-마스터키" />
          <!-- [필수 교체] 초기 admin 비밀번호. PostgreSQL 사용 시 복잡도 규칙이
               자동으로 켜지므로 영문+숫자+특수문자로 지정할 것. -->
          <environmentVariable name="BootstrapAdminPassword" value="CHANGE-ME-Admin1234!" />

          <!-- 업로드 파일 저장 경로. 배포 환경에서는 반드시 지정해야 한다
               (기본값은 개발 폴더 구조 기준이라 여기서는 틀린 곳을 가리킨다). -->
          <environmentVariable name="MediaRoot" value="C:\inetpub\SignalLink\media" />

          <!-- DB 선택: PostgreSQL 이면 DatabaseUrl 을 지정(권장, 운영).
               지정하지 않으면 SqlitePath 의 SQLite 파일을 쓴다(시험 가동용). -->
          <!-- <environmentVariable name="DatabaseUrl" value="postgresql://user:pw@host/signallink" /> -->
          <environmentVariable name="SqlitePath" value="C:\inetpub\SignalLink\data\signallink.db" />
        </environmentVariables>
      </aspNetCore>

      <!-- 동영상 10GB 정책에 맞춰 IIS 요청 크기 상한(기본 30MB)을 올린다. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="10737418240" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
