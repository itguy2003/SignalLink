# 개발용은 비워두면 SQLite(./signallink.db)를 사용한다.
# 운영은 PostgreSQL DSN을 지정한다.
# DATABASE_URL=postgresql+psycopg://signallink:password@localhost:5432/signallink
DATABASE_URL=

# JWT 서명 키 / 장치 채널 암호화 마스터 키 — 운영에서는 반드시 교체할 것
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEVICE_MASTER_KEY=change-me-too-device-channel-master-key

# 비밀번호 복잡도(영문·숫자·특수문자 각 1+) — on / off / auto.
# auto(기본)는 운영 DB(PostgreSQL)일 때만 켠다. 배포에서는 auto 또는 on 을 쓸 것.
PASSWORD_COMPLEXITY=auto

ACCESS_TOKEN_EXPIRE_MINUTES=480

# 부트스트랩 슈퍼관리자
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234
ROOT_ORG_NAME=최상위 기관

# CORS (프론트엔드 개발 서버)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pixabay 스톡 소재 검색 (콘텐츠 편집기의 '검색' 탭). 이미지와 동영상을
# 키 하나로 함께 쓴다. https://pixabay.com/api/docs/ 에서 발급한다.
# 비워 두면 '검색' 탭이 "설정되지 않음" 안내만 띄운다.
# 프론트엔드에 두지 않는 이유: 번들에 실려 누구나 꺼내 쓸 수 있게 된다.
PIXABAY_API_KEY=
