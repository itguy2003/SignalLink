<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS 기본 본문 상한(30MB)이 동영상 업로드를 막는다 — 앱 상한(220MB)과 맞춘다. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="230686720" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SignalLink.Api.dll" stdoutLogEnabled="true" stdoutLogFile="D:\SignalLink\deploy-data\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="SqlitePath" value="D:\SignalLink\deploy-data\signallink.db" />
          <environmentVariable name="SECRET_KEY" value="dev-secret-key-change-me" />
          <environmentVariable name="DEVICE_MASTER_KEY" value="dev-device-master-key-change-me" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
